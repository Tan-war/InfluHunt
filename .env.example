# Copy this file to .env.local, fill in the values, then restart the dev server (npm run dev).
# Both come from Supabase → Project Settings → API (or "API Keys").

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL

# The publishable key (starts with sb_publishable_) or the legacy "anon" key.
# Never put the secret / service_role key here: anything prefixed VITE_ ships to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY

# ---- Not for this file: Supabase Edge Function secrets (email to recruiters) ----
# These live only in Supabase (Edge Functions → Secrets, or `supabase secrets set NAME=value`).
# Never put them in .env.local or any VITE_ variable: they must not reach the browser.
#   RESEND_API_KEY   Resend API key
#   SITE_URL         the site's address, e.g. https://influhunt.example
#   WEBHOOK_SECRET   long random string; also set as the x-webhook-secret header on the webhook
#   RESEND_FROM      optional sender, e.g. "InfluHunt <hello@yourdomain.com>"
