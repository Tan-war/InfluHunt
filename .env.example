# Copy this file to .env.local, fill in the values, then restart the dev server (npm run dev).
# Both come from Supabase → Project Settings → API (or "API Keys").

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL

# The publishable key (starts with sb_publishable_) or the legacy "anon" key.
# Never put the secret / service_role key here: anything prefixed VITE_ ships to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY
